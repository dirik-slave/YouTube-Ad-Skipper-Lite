{
  "manifest_version": 3,
  "name": "YouTube Ad Skipper - Lite",
  "version": "2.0.0",
  "description": "Does one thing only: automatically skips video ads in the YouTube player. No permissions, no popup, no stats.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ]
}
